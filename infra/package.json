{
  "name": "ghostline-infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "watch": "tsc --noEmit --watch",
    "test:vitest": "vitest run",
    "test:cdk": "node --import=tsx scripts/synth-test.ts",
    "test": "npm run build && npm run test:cdk && npm run test:vitest",
    "synth": "node --import=tsx scripts/deployment.ts synth",
    "diff": "node --import=tsx scripts/deployment.ts diff",
    "deploy": "node --import=tsx scripts/deployment.ts deploy",
    "cdk": "cdk",
    "preflight": "node --import=tsx scripts/deployment.ts preflight",
    "deployments": "node --import=tsx scripts/deployment.ts list",
    "runtime": "node --import=tsx scripts/runtime.ts",
    "test:runtime": "node --import=tsx scripts/runtime-test.ts"
  },
  "dependencies": {
    "aws-cdk-lib": "2.268.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "aws-cdk": "2.1140.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
