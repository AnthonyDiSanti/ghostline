{
  "name": "ghostline-infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc --noEmit && npm run build --prefix packages/notifications",
    "watch": "tsc --noEmit --watch",
    "test:vitest": "vitest run",
    "test:ecs-images": "node --import=tsx scripts/ecs-image-test.ts",
    "images:build": "node --import=tsx scripts/images-build.ts",
    "test:cdk": "node --import=tsx scripts/synth-test.ts",
    "test:assets": "python3 -B scripts/check-assets.py",
    "lint:shell": "python3 -B scripts/check-assets.py shellcheck",
    "lint:docker": "python3 -B scripts/check-assets.py hadolint",
    "test": "npm run build && npm run test:assets && npm run test:cdk && npm run test:vitest",
    "synth": "node --import=tsx scripts/deployment.ts synth",
    "diff": "node --import=tsx scripts/deployment.ts diff",
    "deploy": "node --import=tsx scripts/deployment.ts deploy",
    "cdk": "cdk",
    "preflight": "node --import=tsx scripts/deployment.ts preflight",
    "deployments": "node --import=tsx scripts/deployment.ts list",
    "park": "node --import=tsx scripts/deployment.ts park",
    "destroy": "node --import=tsx scripts/destroy.ts",
    "ecs": "node --import=tsx scripts/ecs.ts",
    "release": "node --import=tsx scripts/release.ts",
    "platform": "node --import=tsx scripts/platform.ts",
    "audit": "node --import=tsx scripts/audit.ts",
    "trial:al2023-gate": "cdk --app 'node --import=tsx bin/al2023-boot-gate-trial.ts'"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "3.1129.0",
    "@aws-sdk/client-cloudtrail": "3.1129.0",
    "@aws-sdk/client-dynamodb": "3.1129.0",
    "@aws-sdk/client-ec2": "3.1129.0",
    "@aws-sdk/client-ecr": "3.1129.0",
    "@aws-sdk/client-ecs": "3.1129.0",
    "@aws-sdk/client-eventbridge": "3.1129.0",
    "@aws-sdk/client-guardduty": "3.1129.0",
    "@aws-sdk/client-lambda": "3.1129.0",
    "@aws-sdk/client-s3": "3.1129.0",
    "@aws-sdk/client-sns": "3.1129.0",
    "@aws-sdk/client-ssm": "3.1129.0",
    "@aws-sdk/credential-providers": "3.1129.0",
    "@ghostline/aws-notifications": "file:packages/notifications",
    "aws-cdk-lib": "2.268.0",
    "constructs": "10.8.1",
    "qrcode": "1.5.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/qrcode": "1.5.6",
    "aws-cdk": "2.1140.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
